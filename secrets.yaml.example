# Vorlage für secrets.yaml
#
# So benutzen:
#   1. Diese Datei nach "secrets.yaml" kopieren
#   2. Alle Platzhalter durch echte Werte ersetzen
#   3. secrets.yaml NIEMALS committen (steht in .gitignore)
#
# Im ESPHome Device Builder Add-on liegt secrets.yaml im selben Verzeichnis
# wie stockwaage.yaml (/config/esphome/secrets.yaml). Wenn dort schon eine
# secrets.yaml für die anderen Geräte (D1-Mini-Tester, Display3) existiert,
# dann NICHT überschreiben, sondern nur die hier fehlenden Keys ergänzen.
#
# Alle Geräte teilen sich diese Werte. Das ist
# zulässig und hält die Datei klein. Wer pro Gerät eigene Schlüssel will,
# legt sie hier zusätzlich unter eigenem Namen an (z. B. api_key_stock2) und
# kommentiert den dafür vorbereiteten Block in der Stock-Datei ein.

# --- WLAN ---
wifi_ssid: "MEIN-WLAN"
wifi_password: "mein-wlan-passwort"

# Passwort für die Fallback-Hotspots ("Stockwaage Fallback", ...).
# Gilt für alle Geräte.
# Mindestens 8 Zeichen, sonst startet der Accesspoint nicht.
ap_fallback_password: "bitte-aendern-8plus"

# --- Home Assistant API ---
# 32 Byte, base64-kodiert. Erzeugen mit einem der beiden Wege:
#   openssl rand -base64 32
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Oder bequem im Browser: https://esphome.io/components/api.html (Key-Generator)
# Denselben Key trägt HA beim Hinzufügen des Geräts ein.
api_encryption_key: "ERSETZEN-32-BYTE-BASE64-KEY"

# --- OTA (Over-the-Air-Updates) ---
# Frei wählbar, wird beim ersten Flashen mitgeschrieben. Merken! Ohne dieses
# Passwort sind spätere Updates über WLAN nicht mehr möglich (dann hilft nur
# noch Flashen per USB).
ota_password: "bitte-ein-eigenes-ota-passwort"
